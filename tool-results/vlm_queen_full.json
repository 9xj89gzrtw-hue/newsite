        "content": "```html\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Queen of Hearts Catering - Expert Catering, Effortless Events</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\">\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Lato:wght@300;400;700&display=swap');\n        \n        body {\n            font-family: 'Lato', sans-serif;\n            color: #333;\n            background-color: #fff;\n        }\n        h1, h2, h3, .serif-font {\n            font-family: 'Playfair Display', serif;\n        }\n        .nav-link {\n            position: relative;\n        }\n        .nav-link::after {\n            content: '';\n            position: absolute;\n            width: 0;\n            height: 2px;\n            bottom: -4px;\n            left: 0;\n            background-color: #d4af37; /* Gold accent */\n            transition: width 0.3s ease;\n        }\n        .nav-link:hover::after {\n            width: 100%;\n        }\n        /* Custom scrollbar for a polished feel */\n        ::-webkit-scrollbar {\n            width: 8px;\n        }\n        ::-webkit-scrollbar-track {\n            background: #f1f1f1; \n        }\n        ::-webkit-scrollbar-thumb {\n            background: #888; \n            border-radius: 4px;\n        }\n        ::-webkit-scrollbar-thumb:hover {\n            background: #555; \n        }\n    </style>\n</head>\n<body class=\"antialiased\">\n\n    <!-- Navigation -->\n    <header class=\"sticky top-0 z-50 bg-white/95 backdrop-blur-sm shadow-sm\">\n        <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n            <div class=\"flex justify-between items-center py-6 md:justify-start md:space-x-10\">\n                <!-- Logo -->\n                <div class=\"flex justify-start lg:flex-1\">\n                    <a href=\"#\" class=\"flex items-center space-x-2 group\">\n                        <i class=\"fas fa-crown text-[#8B0000] text-2xl group-hover:text-[#d4af37] transition-colors\"></i>\n                        <span class=\"text-xl font-bold tracking-tight serif-font text-gray-900\">Queen of Hearts</span>\n                    </a>\n                </div>\n\n                <!-- Desktop Nav -->\n                <nav class=\"hidden md:flex space-x-8\">\n                    <a href=\"#weddings\" class=\"text-sm font-medium text-gray-700 hover:text-[#8B0000] nav-link\">Weddings</a>\n                    <a href=\"#events\" class=\"text-sm font-medium text-gray-700 hover:text-[#8B0000] nav-link\">Events</a>\n                    <a href=\"#about\" class=\"text-sm font-medium text-gray-700 hover:text-[#8B0000] nav-link\">About</a>\n                    <a href=\"#venues\" class=\"text-sm font-medium text-gray-700 hover:text-[#8B0000] nav-link\">Venues</a>\n                    <a href=\"#contact\" class=\"text-sm font-medium text-gray-700 hover:text-[#8B0000] nav-link\">Contact</a>\n                </nav>\n\n                <!-- Mobile Menu Button -->\n                <div class=\"-mr-2 -my-2 md:hidden flex items-center\">\n                    <button type=\"button\" onclick=\"document.getElementById('mobile-menu').classList.toggle('hidden')\" class=\"bg-white rounded-md p-2 inline-flex items-center justify-center text-gray-400 hover:text-gray-500 hover:bg-gray-100 focus:outline-none\">\n                        <span class=\"sr-only\">Open menu</span>\n                        <i class=\"fas fa-bars h-6 w-6\"></i>\n                    </button>\n                </div>\n            </div>\n        </div>\n\n        <!-- Mobile Nav -->\n        <div id=\"mobile-menu\" class=\"hidden md:hidden bg-white border-t\">\n            <div class=\"pt-2 pb-3 space-y-1 px-4\">\n                <a href=\"#weddings\" class=\"block pl-3 pr-4 py-2 border-l-4 border-transparent text-base font-medium text-gray-600 hover:bg-gray-50 hover:border-[#8B0000]\">Weddings</a>\n                <a href=\"#events\" class=\"block pl-3 pr-4 py-2 border-l-4 border-transparent text-base font-medium text-gray-600 hover:bg-gray-50 hover:border-[#8B0000]\">Events</a>\n                <a href=\"#about\" class=\"block pl-3 pr-4 py-2 border-l-4 border-transparent text-base font-medium text-gray-600 hover:bg-gray-50 hover:border-[#8B0000]\">About</a>\n                <a href=\"#contact\" class=\"block pl-3 pr-4 py-2 border-l-4 border-transparent text-base font-medium text-gray-600 hover:bg-gray-50 hover:border-[#8B0000]\">Contact</a>\n            </div>\n        </div>\n    </header>\n\n    <!-- Hero Section -->\n    <section id=\"hero\" class=\"relative bg-gray-900 overflow-hidden\">\n        <div class=\"absolute inset-0\">\n            <img src=\"https://images.unsplash.com/photo-1519225421980-715cb0215aed?q=80&w=2070&auto=format&fit=crop\" alt=\"Elegant Wedding Table Setting\" class=\"w-full h-full object-cover opacity-60\">\n            <div class=\"absolute inset-0 bg-gradient-to-r from-black/70 to-transparent\"></div>\n        </div>\n        <div class=\"relative max-w-7xl mx-auto py-24 px-4 sm:py-32 sm:px-6 lg:px-8 flex items-center min-h-[500px]\">\n            <div class=\"max-w-2xl\">\n                <h1 class=\"text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl leading-tight mb-6\">\n                    EXPERT CATERING.<br>EFFORTLESS EVENTS.\n                </h1>\n                <p class=\"mt-6 text-lg text-gray-300 sm:text-xl leading-relaxed\">\n                    Planning your Philadelphia wedding or event should be simple. At Queen of Hearts Catering, our event coordinators make sure that every detail is considered, from decor to menu.\n                </p>\n                <div class=\"mt-10 flex flex-col sm:flex-row gap-4\">\n                    <a href=\"#contact\" class=\"inline-flex items-center justify-center px-8 py-3 border border-transparent text-base font-medium rounded-full text-white bg-[#8B0000] hover:bg-[#600000] shadow-lg transform transition hover:-translate-y-1 duration-200\">\n                        Start Planning\n                        <i class=\"ml-2 fas fa-arrow-right\"></i>\n                    </a>\n                    <a href=\"#menu\" class=\"inline-flex items-center justify-center px-8 py-3 border-2 border-white/30 text-base font-medium rounded-full text-white hover:bg-white/10 backdrop-blur-sm transition duration-200\">\n                        View Menus\n                    </a>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Intro / Value Prop -->\n    <section class=\"py-20 bg-white\">\n        <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n            <div class=\"grid grid-cols-1 lg:grid-cols-2 gap-16 items-center\">\n                <div>\n                    <h2 class=\"text-3xl font-bold text-gray-900 sm:text-4xl mb-6 serif-font\">\n                        SIMPLE PLANNING,<br>DREAM WEDDINGS.\n                    </h2>\n                    <p class=\"mt-4 text-lg text-gray-500 leading-relaxed\">\n                        You should be able to enjoy your own wedding and every moment planning it. Our goal is to make your wedding catering, planning and entire day easy with our simple planning guide and event coordinators, ensuring that you feel confident each step of the way.\n                    </p>\n                    <p class=\"mt-4 text-lg text-gray-500 leading-relaxed\">\n                        On your big day, we want you to host a wedding that you are proud of, making beautiful memories, celebrating your love and not worrying about a thing.\n                    </p>\n                    <a href=\"#\" class=\"inline-block mt-8 text-[#8B0000] font-semibold hover:underline decoration-2 underline-offset-4\">\n                        THE QUEEN OF HEARTS DIFFERENCE &rarr;\n                    </a>\n                </div>\n                <div class=\"relative\">\n                    <img src=\"https://images.unsplash.com/photo-1464366400600-7168b8af9bc3?q=80&w=2069&auto=format&fit=crop\" alt=\"Happy Bride and Groom\" class=\"rounded-lg shadow-2xl w-full object-cover h-[400px]\">\n                    <div class=\"absolute -bottom-6 -left-6 bg-[#d4af37] text-white p-6 rounded-lg shadow-xl hidden sm:block\">\n                        <p class=\"font-serif text-2xl font-bold\">15+</p>\n                        <p class=\"text-xs uppercase tracking-wide\">Years Experience</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Backyard Weddings Feature -->\n    <section id=\"weddings\" class=\"py-20 bg-stone-50\">\n        <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n            <div class=\"max-w-3xl mx-auto text-center mb-16\">\n                <h2 class=\"text-3xl font-extrabold text-gray-900 sm:text-4xl serif-font\">\n                    PERFECT BACKYARD WEDDINGS\n                </h2>\n                <p class=\"mt-4 text-lg text-gray-500\">\n                    At Queen of Hearts Catering, we're ready for anything—including your backyard wedding! Our team has years of experience transforming special, non-traditional venues—like your backyard—into your dream wedding destination.\n                </p>\n            </div>\n\n            <!-- Social Proof / Instagram Feed Simulation -->\n            <div class=\"bg-white p-8 rounded-xl shadow-sm border border-gray-100\">\n                <h3 class=\"text-xl font-bold text-gray-800 mb-6 flex items-center\">\n                    <i class=\"fab fa-instagram text-pink-600 mr-3\"></i> Backyard Works\n                </h3>\n                <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n                    <!-- Card 1 -->\n                    <div class=\"group cursor-pointer\">\n                        <div class=\"overflow-hidden rounded-lg aspect-video relative\">\n                            <img src=\"https://images.unsplash.com/photo-1522673607200-164d1b6ce486?q=80&w=2070&auto=format&fit=crop\" alt=\"Backyard Setup\" class=\"object-cover w-full h-full transform group-hover:scale-105 transition duration-500\">\n                            <div class=\"absolute inset-0 bg-black/20 group-hover:bg-black/0 transition\"></div>\n                        </div>\n                        <p class=\"mt-3 text-sm text-gray-600 line-clamp-2\">\n                            This shrimp cocktail, maple dijon chicken, mini crab cakes and scallions wrapped in bacon were the delicious passed hors d'oeuvres for this wedding at Springton Manor Farm...\n                        </p>\n                        <div class=\"mt-2 flex gap-2 text-xs text-blue-500\">\n                            <span>#weddingfood</span><span>#catering</span><span>#philly</span>\n                        </div>\n                    </div>\n                    <!-- Card 2 -->\n                    <div class=\"group cursor-pointer\">\n                        <div class=\"overflow-hidden rounded-lg aspect-video relative\">\n                            <img src=\"https://images.unsplash.com/photo-1511795409834-ef04bbd61622?q=80&w=2069&auto=format&fit=crop\" alt=\"Outdoor Reception\" class=\"object-cover w-full h-full transform group-hover:scale-105 transition duration-500\">\n                             <div class=\"absolute inset-0 bg-black/20 group-hover:bg-black/0 transition\"></div>\n                        </div>\n                        <p class=\"mt-3 text-sm text-gray-600 line-clamp-2\">\n                            Don't forget the drinks! We've got you covered with signature drinks and bar packages that take your event to the next level...\n                        </p>\n                         <div class=\"mt-2 flex gap-2 text-xs text-blue-500\">\n                            <span>#barpackages</span><span>#cocktails</span><span>#party</span>\n                        </div>\n                    </div>\n                     <!-- Card 3 -->\n                     <div class=\"group cursor-pointer\">\n                        <div class=\"overflow-hidden rounded-lg aspect-video relative\">\n                            <img src=\"https://images.unsplash.com/photo-1530103862676-de8c9debad1d?q=80&w=2070&auto=format&fit=crop\" alt=\"Egg Rolls\" class=\"object-cover w-full h-full transform group-hover:scale-105 transition duration-500\">\n                             <div class=\"absolute inset-0 bg-black/20 group-hover:bg-black/0 transition\"></div>\n                        </div>\n                        <p class=\"mt-3 text-sm text-gray-600 line-clamp-2\">\n                            Egg rolls so crispy we can hear the crunch! These are sure to fly off the platter at any event...\n                        </p>\n                         <div class=\"mt-2 flex gap-2 text-xs text-blue-500\">\n                            <span>#appetizers</span><span>#crispy</span><span>#yum</span>\n                        </div>\n                    </div>\n                     <!-- Card 4 -->\n                     <div class=\"group cursor-pointer\">\n                        <div class=\"overflow-hidden rounded-lg aspect-video relative\">\n                            <img src=\"https://images.unsplash.com/photo-1464207687429-7505649dae38?q=80&w=2071&auto=format&fit=crop\" alt=\"Table Setting\" class=\"object-cover w-full h-full transform group-hover:scale-105 transition duration-500\">\n                             <div class=\"absolute inset-0 bg-black/20 group-hover:bg-black/0 transition\"></div>\n                        </div>\n                        <p class=\"mt-3 text-sm text-gray-600 line-clamp-2\">\n                            From the first bite to the last, every course is crafted to delight. Nothing beats gathering around the table with the ones you love!\n                        </p>\n                         <div class=\"mt-2 flex gap-2 text-xs text-blue-500\">\n                            <span>#family</span><span>#dinner</span><span>#love</span>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"mt-8 text-center\">\n                    <button class=\"text-sm font-bold text-gray-500 hover:text-[#8B0000] uppercase tracking-wider\">\n                        View More on Instagram <i class=\"fas fa-chevron-right ml-1\"></i>\n                    </button>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Venues Section -->\n    <section id=\"venues\" class=\"py-24 bg-white\">\n        <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n            <div class=\"flex flex-col md:flex-row justify-between items-end mb-12 border-b pb-4\">\n                <div>\n                    <h2 class=\"text-3xl font-extrabold text-gray-900 serif-font\">Exclusive Venues</h2>\n                    <p class=\"mt-2 text-gray-500\">Explore our preferred partners for the perfect setting.</p>\n                </div>\n                <div class=\"mt-4 md:mt-0 space-x-4\">\n                    <button class=\"text-sm font-bold text-[#8B0000] border-b-2 border-[#8B0000] pb-1\">Preferred</button>\n                    <button class=\"text-sm font-bold text-gray-400 hover:text-gray-600 pb-1\">All Venues</button>\n                </div>\n            </div>\n\n            <div class=\"grid grid-cols-1 md:grid-cols-3 gap-8\">\n                <!-- Venue Card 1 -->\n                <div class=\"group bg-white rounded-xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 border border-gray-100\">\n                    <div class=\"relative h-64 overflow-hidden\">\n                        <img src=\"https://images.unsplash.com/photo-1519167758481-83f550bb49b3?q=80&w=1974&auto=format&fit=crop\" alt=\"The Old Mill\" class=\"w-full h-full object-cover transform group-hover:scale-110 transition duration-700\">\n                        <div class=\"absolute top-4 right-4 bg-white/90 p-2 rounded-full text-[#8B0000]\">\n                            <i class=\"fas fa-heart\"></i>\n                        </div>\n                    </div>\n                    <div class=\"p-6\">\n                        <h3 class=\"text-xl font-bold text-gray-900 mb-2\">The Old Mill</h3>\n                        <p class=\"text-gray-500 text-sm mb-4\">Rose Valley, PA</p>\n                        <p class=\"text-gray-600 text-sm mb-6 line-clamp-3\">\n                            \"The wedding reception was spectacular! The staff and catering were at the top of their game. The food was excellent and large open spaces were very impressive.\"\n                        </p>\n                        <a href=\"#\" class=\"inline-flex items-center text-[#8B0000] font-semibold text-sm hover:underline\">\n                            View Gallery <i class=\"fas fa-arrow-right ml-2\"></i>\n                        </a>\n                    </div>\n                </div>\n\n                <!-- Venue Card 2 -->\n                <div class=\"group bg-white rounded-xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 border border-gray-100\">\n                    <div class=\"relative h-64 overflow-hidden\">\n                        <img src=\"https://images.unsplash.com/photo-1478146896981-b80fe463b330?q=80&w=2070&auto=format&fit=crop\" alt=\"Springton Manor Farm\" class=\"w-full h-full object-cover transform group-hover:scale-110 transition duration-700\">\n                         <div class=\"absolute top-4 right-4 bg-white/90 p-2 rounded-full text-gray-300 hover:text-red-500 transition cursor-pointer\">\n                            <i class=\"far fa-heart\"></i>\n                        </div>\n                    </div>\n                    <div class=\"p-6\">\n                        <h3 class=\"text-xl font-bold text-gray-900 mb-2\">Springton Manor Farm</h3>\n                        <p class=\"text-gray-500 text-sm mb-4\">Glenmoore, PA</p>\n                        <p class=\"text-gray-600 text-sm mb-6 line-clamp-3\">\n                            \"Our daughter's wedding at Springton Manor Farm... was everything we hoped it would be and more. Our guests all commented on how it was delicious and HOT.\"\n                        </p>\n                        <a href=\"#\" class=\"inline-flex items-center text-[#8B0000] font-semibold text-sm hover:underline\">\n                            View Gallery <i class=\"fas fa-arrow-right ml-2\"></i>\n                        </a>\n                    </div>\n                </div>\n\n                 <!-- Venue Card 3 -->\n                 <div class=\"group bg-white rounded-xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 border border-gray-100\">\n                    <div class=\"relative h-64 overflow-hidden\">\n                        <img src=\"https://images.unsplash.com/photo-1505236858219-8359eb29e329?q=80&w=2070&auto=format&fit=crop\" alt=\"Private Estate\" class=\"w-full h-full object-cover transform group-hover:scale-110 transition duration-700\">\n                         <div class=\"absolute top-4 right-4 bg-white/90 p-2 rounded-full text-gray-300 hover:text-red-500 transition cursor-pointer\">\n                            <i class=\"far fa-heart\"></i>\n                        </div>\n                    </div>\n                    <div class=\"p-6\">\n                        <h3 class=\"text-xl font-bold text-gray-900 mb-2\">Private Estates</h3>\n                        <p class=\"text-gray-500 text-sm mb-4\">Your Location</p>\n                        <p class=\"text-gray-600 text-sm mb-6 line-clamp-3\">\n                            \"Queen of Hearts Catering exceeded our expectations! The staff were attentive to my gluten preferences (they even made a special gluten-free bruschetta just for me!).\"\n                        </p>\n                        <a href=\"#\" class=\"inline-flex items-center text-[#8B0000] font-semibold text-sm hover:underline\">\n                            View Gallery <i class=\"fas fa-arrow-right ml-2\"></i>\n                        </a>\n                    </div>\n                </div>\n            </div>\n            \n            <div class=\"mt-12 text-center\">\n                <button class=\"px-8 py-3 bg-gray-900 text-white rounded-full font-medium hover:bg-gray-800 transition shadow-lg\">\n                    Explore All Venues\n                </button>\n            </div>\n        </div>\n    </section>\n\n    <!-- Testimonials Section -->\n    <section class=\"py-20 bg-[#fdfbf7]\">\n        <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n            <h2 class=\"text-3xl font-bold text-center text-gray-900 mb-16 serif-font\">What Our Clients Say</h2>\n            \n            <div class=\"relative\">\n                <div class=\"grid grid-cols-1 md:grid-cols-3 gap-8\">\n                    <!-- Testimonial 1 -->\n                    <div class=\"bg-white p-8 rounded-lg shadow-sm border-t-4 border-[#d4af37]\">\n                        <div class=\"flex items-center mb-4\">\n                            <div class=\"text-yellow-400 text-sm\">\n                                <i class=\"fas fa-star\"></i><i class=\"fas fa-star\"></i><i class=\"fas fa-star\"></i><i class=\"fas fa-star\"></i><i class=\"fas fa-star\"></i>\n                            </div>\n                        </div>\n                        <p class=\"text-gray-600 italic mb-6\">\n                            \"We were told several times by our guests that this was easily the best food they've ever had at a wedding. From the menu options, to the tasting experience, to the wonderful staff...\"\n                        </p>\n                        <div class=\"flex items-center mt-auto\">\n                            <div class=\"w-10 h-10 bg-gray-200 rounded-full flex items-center justify-center text-gray-500 font-bold mr-3\">A</div>\n                            <div>\n                                <p class=\"font-bold text-gray-800 text-sm\">Ally B.</p>\n                                <p class=\"text-xs text-gray-500\">Bride</p>\n                            </div>\n                        </div>\n                    </div>\n\n                    <!-- Testimonial 2 -->\n                    <div class=\"bg-white p-8 rounded-lg shadow-sm border-t-4 border-[#d4af37]\">\n                        <div class=\"flex items-center mb-4\">\n                            <div class=\"text-yellow-400 text-sm\">\n                                <i class=\"fas fa-star\"></i><i class=\"fas fa-star\"></i><i class=\"fas fa-star\"></i><i class=\"fas fa-star\"></i><i class=\"fas fa-star\"></i>\n                            </div>\n                        </div>\n                        <p class=\"text-gray-600 italic mb-6\">\n                            \"The wedding reception was spectacular! The Old Mill is terrific venue for special occasions. The staff and catering were at the top of their game. The food was excellent...\"\n                        </p>\n                        <div class=\"flex items-center mt-auto\">\n                            <div class=\"w-10 h-10 bg-gray-200 rounded-full flex items-center justify-center text-gray-500 font-bold mr-3\">C</div>\n                            <div>\n                                <p class=\"font-bold text-gray-800 text-sm\">Carol S.</p>\n                                <p class=\"text-xs text-gray-500\">Mother of Bride</p>\n                            </div>\n                        </div>\n                    </div>\n\n                    <!-- Testimonial 3 -->\n                    <div class=\"bg-white p-8 rounded-lg shadow-sm border-t-4 border-[#d4af37]\">\n                        <div class=\"flex items-center mb-4\">\n