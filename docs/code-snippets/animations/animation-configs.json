{"_meta": {"description": "Animation configuration patterns extracted from 15 catering reference sites", "sourceCount": 15, "extractionDate": "2025-01-18", "librariesFound": ["GSAP", "ScrollTrigger", "Lenis", "Splide", "Swiper", "AOS", "Lottie"]}, "gsap_patterns": [{"pattern": "gsap.registerPlugin(ScrollTrigger)", "usage": "Initialize ScrollTrigger for scroll-based animations", "source": "gammacatering.com"}, {"pattern": "gsap.matchMedia()", "usage": "Responsive breakpoint-specific animations", "source": "gammacatering.com"}, {"pattern": "gsap.set([elements], {opacity:0, ...})", "usage": "Set initial hidden state before animating in", "source": "gammacatering.com"}, {"pattern": "gsap.timeline({delay:.35, defaults:{ease:'power3.out'}})", "usage": "Create sequenced animation timeline with defaults", "source": "gammacatering.com"}, {"pattern": "gsap.to(el, { xPercent: -50, ease: 'none', duration: 35, repeat: -1 })", "usage": "Infinite marquee/scroll animation", "source": "gammacatering.com"}], "easing_functions": {"power3.out": {"description": "Strong deceleration, good for entrances", "useCase": "Hero animations, element reveals", "sources": ["gammacatering.com"]}, "power2.out": {"description": "Medium deceleration", "useCase": "General UI animations", "sources": []}, "none": {"description": "Linear easing", "useCase": "Infinite loops (marquee)", "sources": ["gammacatering.com"]}, "cubic-bezier(0.37, 0, 0.63, 1)": {"description": "Custom smooth easing for sliders", "useCase": "Splide slider transitions", "sources": ["gammacatering.com"]}}, "animation_data_attributes": {"direction": ["left", "right"], "speed": ["0.5", "1"], "role": ["button", "content", "header-element", "image"], "type": ["lottie", "cross", "default", "none", "site-default"], "state": ["booted"], "override": [""], "blockAnimation": ["none"]}, "scroll_animation_config": {"intersectionObserver": {"threshold": 0, "rootMargin": "0px", "usage": "Detect when hero leaves viewport to toggle header class"}, "scrollTrigger_defaults": {"start": "top 80%", "end": "bottom 20%", "toggleActions": "play none none reverse"}}, "responsive_breakpoints": {"mobile": "(max-width: 47.9375rem)", "tablet": "(min-width: 48rem) and (max-width: 63.9375rem)", "desktop": "(min-width: 64rem)"}, "smooth_scroll_config": {"library": "Lenis", "settings": {"duration": 1.8, "easing": "(t) => Math.min(1, 1.001 - Math.pow(2, -10 * t))", "orientation": "vertical", "gestureOrientation": "vertical", "smoothWheel": true, "wheelMultiplier": 0.6, "touchMultiplier": 1.8, "infinite": false}, "gsap_integration": {"syncMethod": "lenis.on('scroll', ScrollTrigger.update)", "tickerMethod": "gsap.ticker.add((time) => lenis.raf(time * 1000))", "lagSmoothing": 0}}, "marquee_configs": {"text_marquee": {"method": "GSAP only", "technique": "Clone content, animate both original and clone to xPercent: -50", "duration": 35, "repeat": -1, "ease": "none"}, "image_marquee": {"method": "Splide + AutoScroll extension", "settings": {"type": "loop", "drag": "free", "focus": "center", "perPage": 1, "autoWidth": true, "gap": "12px", "arrows": false, "pagination": false, "autoScroll": {"speed": 0.5, "pauseOnHover": true, "pauseOnFocus": false}}}}, "accessibility": {"prefers_reduced_motion_check": "window.matchMedia('(prefers-reduced-motion: reduce)').matches", "fallback_behavior": "Show end state via CSS class, skip JS animations"}}