"example": "Wolfgang's Chinois Chicken Salad", "frequency": "low", "use_case": "Signature dishes only"}, {"template": "{Flavor Profile} {Base Ingredient} {Presentation}", "example": "Citrus Glazed Carrots with Micro Herbs", "frequency": "medium", "use_case": "Side dishes"}, {"template": "{Texture} {Component} {Sauce}", "example": "Crispy Skin Snapper with Ginger Soy Reduction", "frequency": "medium", "use_case": "Seafood entrees"}, {"template": "{Cooking Vessel} {Dish Type}", "example": "Cast Iron Skillet Cornbread", "frequency": "medium", "use_case": "Rustic/traditional items"}, {"template": "{Portion Descriptor} {Item} {Garnish Stack}", "example": "Mini Crab Cakes with Remoulade and Pickled Shallots", "frequency": "high", "use_case": "Appetizers/hors d'oeuvres"}], "origin_region_mentions": [{"term": "Mediterranean", "association": "Olive oil, fresh herbs, grilled items, seafood focus"}, {"term": "Asian-Inspired/Fusion", "association": "Soy, ginger, sesame, rice noodles, dumplings"}, {"term": "Southern/Creole", "association": "Andouille, Cajun spices, shrimp grits, fried chicken"}, {"term": "French Classical", "association": "Butter sauces, terrines, pâtés, elegant plating"}, {"term": "Italian", "association": "Fresh pasta, risotto, Parmesan, balsamic reductions"}, {"term": "Farm-to-Table/Local", "association": "Seasonal vegetables, regional proteins, artisan products"}, {"term": "Pacific Northwest", "association": "Wild salmon, foraged mushrooms, cedar planking"}, {"term": "Tex-Mex/Southwest", "association": "Chipotle, corn, black beans, avocado, lime"}]}, "description_samples": {"short": [{"text": "Wild mushrooms, truffle oil, Parmesan", "word_count": 5, "style": "minimalist_ingredient_list", "site_pattern": "fine_dining"}, {"text": "With seasonal vegetables", "word_count": 3, "style": "ultra_brief", "site_pattern": "casual_catering"}, {"text": "Served with roasted garlic mashed potatoes", "word_count": 6, "style": "single_accompaniment", "site_pattern": "standard_catering"}, {"text": "GF available", "word_count": 2, "style": "dietary_note_only", "site_pattern": "menu_icon_system"}], "medium": [{"text": "Tender beef short ribs slowly braised in red wine with root vegetables and herb-infused jus. Served with creamy polenta and sautéed kale.", "word_count": 22, "style": "descriptive_with_components", "site_pattern": "full_service_caterer"}, {"text": "Fresh catch of the day pan-seared to perfection, finished with a lemon butter caper sauce. Accompanied by wild rice pilaf and grilled asparagus.", "word_count": 23, "style": "chef_preparation_focus", "site_pattern": "seafood_specialist"}, {"text": "Free-range chicken breast stuffed with herbed goat cheese and sun-dried tomatoes. Roasted until golden with a white wine pan sauce.", "word_count": 21, "style": "technique_highlighted", "site_pattern": "chef_driven_menu"}], "descriptive": [{"text": "Our signature dish features a premium center-cut filet mignon, aged minimum 28 days for optimal tenderness. The steak is seared over high heat to develop a deep, flavorful crust while maintaining a juicy, medium-rare interior. Presented with a rich Bordelaise sauce made from reduced cabernet, shallots, and bone marrow, alongside truffle mashed potatoes finished with aged Parmigiano-Reggiano and broccolini glazed with brown butter and garlic.", "word_count": 68, "style": "luxury_storytelling", "site_pattern": "premium_luxury_caterer", "sensory_elements": ["visual: deep flavorful crust", "texture: juicy medium-rare interior", "taste: rich Bordelaise, aged Parmigiano", "aroma: brown butter garlic", "origin: 28-day aged, cabernet reduction"]}, {"text": "Inspired by the bounty of local farms, this vegetarian centerpiece celebrates seasonal produce at its peak. A portobello mushroom cap marinated in balsamic and herbs, then grilled to smoky perfection, rests on a bed of creamy risotto studded with English peas and shaved asparagus. Topped with a sunny-side quail egg whose golden runny yolk creates a natural sauce when broken, finished with micro basil and a drizzle of truffle oil. A dish that satisfies even the most dedicated carnivore.", "word_count": 76, "style": "narrative_emotional", "site_pattern": "farm_to_table_caterer", "sensory_elements": ["visual: sunny-side quail egg, golden yolk", "texture: creamy risotto, smoky mushroom", "taste: balsamic herbs, truffle finish", "emotional: satisfies carnivores", "origin: local farms, seasonal peak"]}, {"text": "A tribute to coastal living, this appetizer features jumbo lump crab meat, hand-picked from Maryland's finest blue crab, barely bound with just enough aioli to hold together delicate cakes that are pan-fried until golden and crisp. The exterior gives way to sweet, succulent crab that tastes of salt air and summer. Paired with a house-made remoulade featuring cornichons, capers, and a hint of paprika, pickled shallots for brightness, and a microgreen salad dressed in citrus vinaigrette.", "word_count": 73, "style": "regional_terroir", "site_pattern": "regional_specialist", "sensory_elements": ["origin: Maryland blue crab", "technique: hand-picked, pan-fried", "texture: golden crisp exterior, sweet succulent interior", "taste: salt air, summer, remoulade complexity", "visual: microgreen salad, golden cakes"]}]}, "sensory_language_library": {"visual_descriptors": ["golden-browned", "glistening", "caramelized", "vibrant", "drizzled", "dusted", "finished with", "crowned with", "nestled among", "arranged around", "plated with", "garnished with", "sprinkled with", "topped with"], "texture_words": ["tender", "juicy", "crispy", "creamy", "silky", "velvety", "crunchy", "flaky", "succulent", "meltingly soft", "al dente", "perfectly seared", "light as air", "rich and dense"], "taste_terms": ["umami-rich", "bright", "well-balanced", "bold", "subtle", "complex layers", "hint of", "nuanced", "clean finish", "lingering", "depth", "sophisticated", "approachable", "comforting", "refreshing", "indulgent", "zesty", "earthy