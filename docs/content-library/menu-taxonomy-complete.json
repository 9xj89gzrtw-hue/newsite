], "premium_signal": false}, {"word": "Wild-Caught", "usage_count": 28, "examples": ["Wild-Caught Salmon", "Wild-Caught Sea Bass"], "premium_signal": true}, {"word": "Slow-Roasted", "usage_count": 25, "examples": ["Slow-Roasted Pork Shoulder", "Prime Rib Slow-Roasted"], "premium_signal": true}, {"word": "Hand-Cut", "usage_count": 22, "examples": ["Hand-Cut Pasta", "Hand-Cut Fries", "Hand-Cut Steak Tips"], "artisanal_signal": true}, {"word": "House-Made", "usage_count": 20, "examples": ["House-Made Ravioli", "House-Made Dressings", "House-Made Desserts"], "artisanal_signal": true}, {"word": "Citrus-Glazed", "usage_count": 18, "examples": ["Citrus-Glazed Carrots", "Citrus-Glazed Chicken"], "flavor_profile": true}, {"word": "Honey-Lacquered", "usage_count": 15, "examples": ["Honey-Lacquered Duck", "Honey-Lacquered Pork Belly"], "luxury_signal": true}, {"word": "Smoked", "usage_count": 32, "examples": ["Smoked Brisket", "Smoked Salmon", "Apple-Smoked Bacon"], "specialty_signal": true}, {"word": "Braised", "usage_count": 24, "examples": ["Braised Short Ribs", "Braised Cabbage", "Braised Lamb Shanks"], "comfort_signal": true}, {"word": "Crispy", "usage_count": 21, "examples": ["Crispy Skin Salmon", "Crispy Fried Chicken", "Crispy Potatoes"], "texture_signal": true}, {"word": "Tender", "usage_count": 19, "examples": ["Tender Baby Greens", "Tenderloin Tips", "Tender Braised Beef"], "texture_signal": true}, {"word": "Butter-Basted", "usage_count": 16, "examples": ["Butter-Basted Lobster", "Butter-Basted Steak"], "indulgence_signal": true}, {"word": "Truffle-Infused", "usage_count": 14, "examples": ["Truffle-Infused Mashed Potatoes", "Truffle-Infused Risotto"], "luxury_signal": true}, {"word": "Locally-Sourced", "usage_count": 26, "examples": ["Locally-Sourced Vegetables", "Locally-Sourced Beef"], "sustainability_signal": true}, {"word": "Organic", "usage_count": 23, "examples": ["Organic Mixed Greens", "Organic Free-Range Chicken"], "health_signal": true}, {"word": "Seasonal