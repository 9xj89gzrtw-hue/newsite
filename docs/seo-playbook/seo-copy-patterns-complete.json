elegantaffairs", "text": "Top Quality Full Service Off-Premise Catering With Elegant Affairs. We Cater Weddings, Corporate Events, and Private Parties in NYC, and Hamptons.", "length": 147, "has_cta": false, "keywords": ["NYC", "Hamptons", "full service", "off-premise"], "unique_value_proposition": "top quality off-premise catering"}, {"site": "saltblock", "text": "Elevate your event with SaltBlock Hospitality's food and beverage experiences at exclusive Tampa venues and farm-fresh ingredients. Plan with confidence!", "length": 143, "has_cta": true, "keywords": ["Tampa", "farm-fresh", "exclusive venues"], "unique_value_proposition": "exclusive venues with farm-fresh ingredients"}, {"site": "sopranos", "text": "Sopranos caters to all of Southeast Michigan for weddings, corporate events, and social events large and small. Everything from full service catering to pick up and drop off services for your special event catering needs.", "length": 208, "has_cta": false, "keywords": ["Southeast Michigan", "weddings", "corporate", "full service"], "unique_value_proposition": "full range from full-service to drop-off"}, {"site": "tallguy", "text": "Tall Guy and a Grill is a farm-to-fork catering company serving the Milwaukee area and is the only certified green caterer in Wisconsin.", "length": 126, "has_cta": false, "keywords": ["Milwaukee", "farm-to-fork", "certified green", "Wisconsin"], "unique_value_proposition": "only certified green caterer in Wisconsin"}, {"site": "cutandtaste", "text": "Cut and Taste provides high-end catering Las Vegas events are known for, perfect for any occasion - large or small. From corporate catering to small party catering services, our team can create the most unique and memorable event at the venue of your choice.", "length": 246, "has_cta": false, "keywords": ["Las Vegas", "high-end", "unique", "memorable"], "unique_value_proposition": "most unique and memorable events"}, {"site": "jdkgroup", "text": "Serving Harrisburg, Lancaster, and York, the JDK Group is the region's premier full-service catering and event planning company", "length": 128, "has_cta": false, "keywords": ["Harrisburg", "Lancaster", "York", "premier", "event planning"], "unique_value_proposition": "region's premier full-service catering AND event planning"}], "services": [], "gallery": [], "contact": [], "about": []}, "best_practices_identified": ["Include primary geographic target", "Mention key service types", "State unique value proposition clearly", "Keep between 140-160 characters optimal", "Include soft CTA when appropriate", "Use emotional benefit words", "Reference credentials/years in business", "Mention specific event types served"], "ctas_used": ["Book Now!", "Get started today", "Contact us for a quote", "Request your custom menu", "Plan with confidence!", "See why we're perfect for you", "View our menus", "Start Planning", "Celebrate with us"], "length_analysis": {"optimal_range": "140-160 characters", "min_found": 114, "max_found": 268, "average": 168, "google_display_limit": "155-160 characters"}, "keyword_placement_patterns": ["[Location] + [Service] + [USP]", "[Brand] + [Years] + [Location] + [Services]", "[Adjective] + [Service Type] + [Location] + [Benefit]", "[Action verb] + [your event] + [with Brand] + [Location]"]}, "title_tags": {"formats_found": [{"format": "[Brand Name] | [Tagline/USP]", "examples": ["Wolfgang Puck Catering | The Standard for Culinary Excellence", "GAMMACATERING | Premium Catering & Event Experiences", "Home | Global Gourmet"], "usage_count": 8, "separator": "|"}, {"format": "[Service/Quality] [Service Type] | [Brand] | [Location]", "examples": ["Full Service Off Premise Catering| Elegant Affairs| New York", "Luxury Catering in Miami & Palm Beach | Creative Edge Parties"], "usage_count": 5, "separator": "|"}, {"format": "[Brand Name] Only", "examples": ["Concorde Catering", "Radish", "Concept Catering Crew"], "usage_count": 3, "separator": "none"}, {"format": "[Descriptive Phrase] [Brand Nam