# ─────────────────────────────────────────────────────────────
# Catering company site — environment variables
# Copy to `.env` and fill in. NEVER commit real secrets.
# Russian hosting (Timeweb) ready. Data stays in RF (152-ФЗ).
# ─────────────────────────────────────────────────────────────

# Site — production domain (Timeweb / Vercel / any host)
NEXT_PUBLIC_SITE_URL="https://your-domain.ru"

# Hosting target (informational, drives deployment docs)
# "vercel" | "timeweb" | "self-hosted"
HOSTING_TARGET="timeweb"

# Database — PostgreSQL (Timeweb / Vercel Postgres / Neon / Supabase / Turso)
# Timeweb: Панель → Базы данных → PostgreSQL → создать → скопировать connection string
# Local:  docker run -e POSTGRES_PASSWORD=pg -p 5432 postgres, then:
#         postgresql://postgres:pg@localhost:5432/catering
DATABASE_URL="postgresql://user:pass@host:5432/catering"

# Analytics — Yandex.Metrika (152-ФЗ compliant, loads AFTER cookie consent)
# Create tag: https://metrika.yandex.ru → Добавить счётчик
NEXT_PUBLIC_YANDEX_METRIKA=""

# Mux (video hero, optional) — https://dashboard.mux.com
MUX_TOKEN_ID=""
MUX_TOKEN_SECRET=""
NEXT_PUBLIC_MUX_ENVIRONMENT_KEY=""

# Cloudflare Stream (fallback video, optional) — https://dash.cloudflare.com
CF_STREAM_ACCOUNT_ID=""
CF_STREAM_API_TOKEN=""

# Auth (NextAuth, optional — admin/order pages only)
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Z.ai SDK (skills: web-search, image-gen, LLM — for development)
ZAI_API_KEY=""
