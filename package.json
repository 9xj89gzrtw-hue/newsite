{
  "name": "catering-company-site",
  "version": "0.1.0",
  "private": true,
  "description": "Catering company website — rich media, video, animation. Next.js 16 + Tailwind v4 + shadcn/ui + Motion + GSAP + Lenis + Mux.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && node scripts/db-push-if-set.js && next build --webpack",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:push": "prisma db push --accept-data-loss",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@mux/mux-player-react": "^3.13.2",
    "@mux/mux-uploader-react": "^1.0.0",
    "@prisma/client": "^6.11.1",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-query": "^5.82.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.0",
    "gsap": "^3.15.0",
    "jspdf": "^4.2.1",
    "lenis": "^1.3.26",
    "lucide-react": "^0.525.0",
    "motion": "^12.0.0",
    "next": "^16.1.1",
    "next-themes": "^0.4.6",
    "nuqs": "^2.9.6",
    "playwright": "^1.62.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.0.2",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "bun-types": "^1.3.4",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.1.1",
    "prisma": "^6.11.1",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": "22.x"
  },
  "trustedDependencies": [
    "unrs-resolver",
    "prisma",
    "@prisma/client",
    "@prisma/engines"
  ]
}
