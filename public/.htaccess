# nilovcatering.ru — Apache за nginx-фронтом SpaceWeb (shared hosting).
#
# ЗАЧЕМ ЭТОТ ФАЙЛ (c92): Next.js static export кладёт юрстраницы как
# offer.html + КАТАЛОГ offer/ (в каталоге только RSC-поладки __next.*.txt,
# БЕЗ index.html). Apache mod_dir (DirectorySlash) на запрос /offer
# отвечает 301 → /offer/, а в каталоге нет индекса → 403 Forbidden.
# Per-dir mod_rewrite срабатывает РАНЬШЕ mod_dir fixup — отдаём *.html
# по чистому URL без редиректа.
#
# СОЗНАТЕЛЬНО ЗДЕСЬ НЕТ: редиректа http → https. SSL терминирует
# nginx-фронт, Apache видит соединение как http (%{HTTPS} всегда off) —
# правило уведёт сайт в бесконечный редирект. Канонизация обеспечена
# rel=canonical (все страницы отдают https://nilovcatering.ru/…).
#
# РАСШИРЕНИЕ: новая юрстраница /foo → добавить foo в скобки правила ниже.

RewriteEngine On

# Отключаем DirectorySlash (301 → /offer/): на этом хостинге mod_dir
# успевает отредиректить ДО per-dir rewrite, причём в Location подставляет
# http:// (SSL терминирует nginx, Apache видит http). Со слэшем страница
# теперь отдаётся (правило ниже), но чистый URL /offer должен отдаваться
# НАПРЯМУЮ по https — для этого гасим сам редирект. Побочных эффектов нет:
# без слэша на каталоги сайт больше не ссылается.
DirectorySlash Off

# Чистые URL юрстраниц: /offer, /privacy, /terms, /about (и с хвостовым слэшем)
# c101: +about — страница «О компании» (SEO-чеклист, шаг 27)
RewriteRule ^(offer|privacy|terms|about|admin)/?$ $1.html [L]

# c95: серверные каталоги runtime-данных и секретов — недоступны из веба
RedirectMatch 404 ^/(server-data|config)(/.*)?$

# Брендированная 404 из экспорта вместо дефолтной «Object not found!»
ErrorDocument 404 /404.html
