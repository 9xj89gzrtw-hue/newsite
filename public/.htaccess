# nilovcatering.ru — Apache за nginx-фронтом SpaceWeb (shared hosting).
#
# ЗАЧЕМ ЭТОТ ФАЙЛ (c92): Next.js static export кладёт юрстраницы как
# offer.html + КАТАЛОГ offer/ (в каталоге только RSC-поладки __next.*.txt,
# БЕЗ index.html). Apache mod_dir (DirectorySlash) на запрос /offer
# отвечает 301 → /offer/, а в каталоге нет индекса → 403 Forbidden.
# Per-dir mod_rewrite срабатывает РАНЬШЕ mod_dir fixup — отдаём *.html
# по чистому URL без редиректа.
#
# c103 (21.09.2026) — ДОБАВЛЕН редирект http → https + security-заголовки.
# ПРИЧИНА, почему раньше его не было: предыдущая попытка проверяла %{HTTPS},
# а SSL терминирует nginx → Apache ВСЕГДА видит %{HTTPS}=off → редирект
# уходил в бесконечный цикл, и файл оставили без редиректа.
# ЗАМЕР (21.09.2026, probe _probe_proto.php на проде):
#   http://  → X-Forwarded-Proto=http,  %{HTTPS}=ABSENT, SERVER_PORT=80
#   https:// → X-Forwarded-Proto=https, %{HTTPS}=ABSENT, SERVER_PORT=80
# ВЫВОД: nginx ФАКТИЧЕСКИ пробрасывает X-Forwarded-Proto. Проверяем ЕГО,
# а не %{HTTPS} — цикл невозможен (https-запрос условие не выполняет).
#
# РАСШИРЕНИЕ: новая юрстраница /foo → добавить foo в скобки правила ниже.

RewriteEngine On

# c123 (22.09.2026) — charset 301-редиректа: iso-8859-1 → UTF-8.
# ЗАМЕР (22.09.2026, curl --http1.1 http://nilovcatering.ru/):
#   HTTP/1.1 301 Moved Permanently
#   Content-Type: text/html; charset=iso-8859-1   ← ВК трактует как подозрительный
# Vercel на аналогичном редиректе отдаёт Content-Type: text/plain.
# Apache на редиректе выставляет тип TEXT, а charset берёт из AddDefaultCharset.
# AddDefaultCharset можно ставить ТОЛЬКО как директиву конфига (не в .htaccess
# per-dir на shared-хостинге), поэтому правим принудительно — но ТОЛЬКО для
# HTML-документов: 'Header always set Content-Type' БЕЗ условия сломал бы MIME
# у .jpg/.js/.ico (mod_headers применяется к ним тоже — проверено замером).
<IfModule mod_headers.c>
  # Редирект http→https и www→apex: charset UTF-8 вместо iso-8859-1.
  # Используем edit (а НЕ set): edit правит СУЩЕСТВУЮЩЕЕ значение по regex и
  # не сработает там, где charset отсутствует (.jpg/.js/.ico — их MIME цел).
  # <If "%{REQUEST_STATUS}..."> НЕ используем: на shared-хостинге Apache может
  # быть 2.2, где <If> не поддерживается → 500-ошибка на весь сайт.
  # В Apache mod_headers 'edit' заменяет ВСЕ найденные совпадения, поэтому
  # берём одну группу по всему значению regex-шаблона (без обратных ссылок).
  Header always edit Content-Type ^.*iso-8859-1.*$ text/html; charset=UTF-8
</IfModule>

# ── http → https (c103) ───────────────────────────────────────────────────────
# X-Forwarded-Proto есть ТОЛЬКО за nginx-фронтом; для https="https" условие
# ложно → редиректа нет (защита от петли). HTTP_HOST сохраняем, чтобы не
# ломать www. POST на /api/*.php идёт по https → редирект не задевает.
RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# c103: канонизация www → apex (второе зеркало отдавало 200, дублируя индекс)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# Отключаем DirectorySlash (301 → /offer/): на этом хостинге mod_dir
# успевает отредиректить ДО per-dir rewrite, причём в Location подставляет
# http:// (SSL терминирует nginx, Apache видит http). Со слэшем страница
# теперь отдаётся (правило ниже), но чистый URL /offer должен отдаваться
# НАПРЯМУЮ по https — для этого гасим сам редирект. Побочных эффектов нет:
# без слэша на каталоги сайт больше не ссылается.
DirectorySlash Off

# Чистые URL юрстраниц: /offer, /privacy, /terms, /about (и с хвостовым слэшем)
# c101: +about — страница «О компании» (SEO-чеклист, шаг 27)
RewriteRule ^(offer|privacy|terms|about|admin)/?$ $1.html [L]

# c95: серверные каталоги runtime-данных и секретов — недоступны из веба
RedirectMatch 404 ^/(server-data|config)(/.*)?$

# Брендированная 404 из экспорта вместо дефолтной «Object not found!»
ErrorDocument 404 /404.html

# ── Security-заголовки (c103) ──────────────────────────────────────────────────
# Причина: ВК выдаёт «Ссылка nilovcatering.ru выглядит подозрительно», сайт
# отдавал 200 по http и НЕ отдавал ни одного security-заголовка.
#
# c122 (22.09.2026) — ДОБАВЛЕН CSP + Permissions-Policy.
# ПРИЧИНА (замер 22.09.2026): то же самое зеркало на Vercel отдаёт
# Content-Security-Policy, Permissions-Policy и X-Frame-Options: DENY, а
# SpaceWeb — ноль из трёх. Внешняя оценка «безопасности ссылки» (в т.ч. метка
# ВК) отличается ровно на эти заголовки. Прежний запрет на CSP снят: причин
# больше нет — iframe Яндекс.Карты убран (карта — статичный <img>), а Метрика
# и GA4 грузятся ДИНАМИЧЕСКИ и только при наличии ID (в проде сейчас их нет,
# замер: mc.yandex.ru=0, googletagmanager.com=0 в HTML). Их домены всё равно
# внесены в разрешения, чтобы счётчик не сломался при подключении.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  # CSP: default-src 'self'; инлайн-SCRIPT нужен Next.js (bootstrap/Хайдрейшн) —
  # 'unsafe-inline' в script-src вынужденный компромисс для static export.
  # static-maps.yandex.ru — единственная внешняя картинка (карта проезда).
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://mc.yandex.ru https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://mc.yandex.ru https://www.googletagmanager.com; frame-src https://mc.yandex.ru https://youtube.com https://rutube.ru https://vk.com; base-uri 'self'; form-action 'self'; object-src 'none'"
</IfModule>
