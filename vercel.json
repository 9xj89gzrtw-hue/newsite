{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "prisma generate && bun scripts/validate-menu.ts && bun scripts/gen-static-data.ts && bun scripts/gen-menu-pdfs.ts && next build --webpack && bun scripts/check-export.ts",
  "devCommand": "next dev -p 3000",
  "installCommand": "bun install",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/menu", "destination": "/" },
    { "source": "/events", "destination": "/" },
    { "source": "/contacts", "destination": "/" },
    { "source": "/contact", "destination": "/" },
    { "source": "/calculator", "destination": "/" }
  ],
  "redirects": [
    { "source": "/api/:path*", "destination": "/404", "statusCode": 302 },
    { "source": "/server-data/:path*", "destination": "/404", "statusCode": 302 },
    { "source": "/config/:path*", "destination": "/404", "statusCode": 302 }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
